    {
      "parameters": {
        "jsCode": "const textCompleto = $json.output || \"\";\n\n// 1. Limpiar las marcas de formato markdown (```json y ```)\nconst cleanJsonString = textCompleto\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\n// 2. Parsear el texto a un objeto JSON real\nlet datosParseados = {};\n\ntry {\n  datosParseados = JSON.parse(cleanJsonString);\n} catch (error) {\n  // En caso de que la IA responda texto plano sin JSON\n  datosParseados = {\n    datos_completos: false,\n    respuesta_al_usuario: textCompleto\n  };\n}\n\n// 3. Retornar el objeto listo para que n8n reconozca cada propiedad\nreturn {\n  json: datosParseados\n};"
      },
